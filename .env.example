# API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://docagent:docagent@localhost:5432/docagent
DATABASE_URL_SYNC=postgresql+psycopg2://docagent:docagent@localhost:5432/docagent

# Celery (PostgreSQL broker + backend)
CELERY_BROKER_URL=sqla+postgresql://docagent:docagent@localhost:5432/docagent
CELERY_RESULT_BACKEND=db+postgresql://docagent:docagent@localhost:5432/docagent

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8100

# App
APP_ENV=dev
